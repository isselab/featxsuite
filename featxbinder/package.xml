<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>featxbinder</name>
  <version>0.0.0</version>
  <description>The binder for feature implementation</description>
  <author email="jude.gyimah87@gmail.com">Jude Gyimah</author>
  <maintainer email="jude.gyimah87@gmail.com">Jude Gyimah</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <!-- early.launch.py reads the configuration model through featxcli -->
  <exec_depend>featxcli</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
